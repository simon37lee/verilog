## ---------------------------------------------------------------------------
## meta_lab_atlys 제약 파일 (Digilent Atlys, XC6SLX45-CSG324-3)
## ---------------------------------------------------------------------------

## 100 MHz 오실레이터
NET "clk_100m" LOC = "L15" | IOSTANDARD = LVCMOS33;
NET "clk_100m" TNM_NET = "TNM_clk100";
TIMESPEC "TS_clk100" = PERIOD "TNM_clk100" 10 ns HIGH 50%;

## RESET 버튼 (빨간 버튼). 매뉴얼과 달리 실제 보드에서는 평소 1 (M0 겸용 핀) -> active-low
NET "btn_rst_n" LOC = "T15" | IOSTANDARD = LVCMOS33;
NET "btn_rst_n" TIG;

## SW0: 측정 회로 입력 맞바꾸기 (위 = 맞바꿈)
NET "sw_swap" LOC = "A10" | IOSTANDARD = LVCMOS33;
NET "sw_swap" TIG;

## SW1: 그래프 확대 (위 = 확대)
NET "sw_zoom" LOC = "D14" | IOSTANDARD = LVCMOS33;
NET "sw_zoom" TIG;

## LED
NET "led<0>" LOC = "U18" | IOSTANDARD = LVCMOS33;
NET "led<1>" LOC = "M14" | IOSTANDARD = LVCMOS33;
NET "led<2>" LOC = "N14" | IOSTANDARD = LVCMOS33;
NET "led<3>" LOC = "L14" | IOSTANDARD = LVCMOS33;
NET "led<4>" LOC = "M13" | IOSTANDARD = LVCMOS33;
NET "led<5>" LOC = "D4"  | IOSTANDARD = LVCMOS33;
NET "led<6>" LOC = "P16" | IOSTANDARD = LVCMOS33;
NET "led<7>" LOC = "N12" | IOSTANDARD = LVCMOS33;
NET "led<*>" TIG;

## HDMI OUT (J2 커넥터, Bank 0). IOSTANDARD 는 RTL 의 OBUFDS 에서 TMDS_33 으로 지정
NET "hdmi_clk_p"  LOC = "B6";
NET "hdmi_clk_n"  LOC = "A6";
NET "hdmi_d_p<0>" LOC = "D8";
NET "hdmi_d_n<0>" LOC = "C8";
NET "hdmi_d_p<1>" LOC = "C7";
NET "hdmi_d_n<1>" LOC = "A7";
NET "hdmi_d_p<2>" LOC = "B8";
NET "hdmi_d_n<2>" LOC = "A8";

## ---------------------------------------------------------------------------
## TDC: 샘플링 FF -> carry chain -> 탭 FF (clk_s) 경로는 타이밍을 맞추는 경로가 아니다
##   (변화가 지연선 중간까지 갔을 때 샘플링하는 것이 목적). 아주 느슨한 데이터 경로 제약만 걸어서
##   타이밍 리포트에 탭별 도착 시간이 찍히게 한다 -> 탭 지연과 SAMPLE_PHASE 선택에 쓴다.
## ---------------------------------------------------------------------------
INST "u_core/u_det_*/u_ff1/q"         TNM = "TNM_ff1";
INST "u_core/u_det_*/u_chain/taps_*"  TNM = "TNM_taps";
TIMESPEC "TS_tdc" = FROM "TNM_ff1" TO "TNM_taps" 20 ns DATAPATHONLY;

## ---------------------------------------------------------------------------
## TDC 배치 고정: 다시 빌드해도 탭 지연이 바뀌지 않게 지연선(CARRY4 64 개)을 열 하나에 고정하고,
## 샘플링 FF 를 지연선 입구 바로 옆에 둔다. 위치를 바꾸면 `make taps` 로 TAP_X10_A/B 를 다시 맞출 것.
## ---------------------------------------------------------------------------
INST "u_core/u_det_a/u_ff1/q" LOC = "SLICE_X13Y3";
INST "u_core/u_det_a/u_chain/g_c4[0].g_first.u_c4" LOC = "SLICE_X12Y3";
INST "u_core/u_det_a/u_chain/g_c4[1].g_next.u_c4" LOC = "SLICE_X12Y4";
